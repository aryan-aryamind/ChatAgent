# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/chatbase_db?schema=public"

# NextAuth Configuration
# URL where the frontend is running
NEXTAUTH_URL="http://localhost:3006"
# Port for the Next.js server
PORT=3006
# Secret for NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here"

# AI Backend Service (Python FastAPI)
# URL where the crewai-service is running
CREWAI_SERVICE_URL="http://localhost:8016"

# LLM Configuration (crewai-service)
# Choices: groq, xai, ollama
LLM_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# xAI (Grok) Configuration
# XAI_API_KEY=your_xai_key_here
# XAI_MODEL=grok-2
# XAI_BASE_URL=https://api.x.ai/v1

# Ollama Configuration (Local LLM)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# App URL Configuration
# Publicly accessible URL (e.g., ngrok URL for testing webhooks or external access)
NEXT_PUBLIC_APP_URL="http://localhost:3006"

# Google Analytics 4
# GA4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-QMQWW9Q0VR"

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
